{
  "name": "Python 3 Development Container Template",
  "dockerFile": "Dockerfile",

  "customizations": {
    "settings": {
      "files.eol": "\n",
      "editor.formatOnSave": true,
      "python.testing.pytestArgs": ["."],
      "python.testing.unittestEnabled": false,
      "python.testing.pytestEnabled": true,
      "python.formatting.provider": "black",
      "python.linting.mypyEnabled": true,
      "python.linting.enabled": true,
      "remote.extensionKind": {
        "ms-azuretools.vscode-docker": "workspace"
      }
    },
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "Gruntfuggly.todo-tree",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-python.autopep8",
        "ms-python.debugpy",
        "ms-python.python",
        "streetsidesoftware.code-spell-checker",
        "vscode-icons-team.vscode-icons"
      ],
      "settings": {
        "workbench.iconTheme": "vscode-icons"
      }
    }
  },

  "postCreateCommand": "./post_create.sh",

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  "remoteUser": "devil",
  "containerUser": "devil",
  "runArgs": ["--user $(id -u):$(id -g)",
    "--hostname devil",
    "--name devil",
    "--publish 127.0.0.1:8889:8888/tcp"
  ],
  "mounts": [
    {"source": "/home/vlad/Projects", "target":"/Projects", "type":"bind"}
  ],
  "build":{
    "args": {
        "dock_uid": "$( id -u )", 
        "dock_gid": "$( id -g )"
    },
    "dockerfile": "./Dockerfile",
    "options": ["--rm", "--tag compass-py3_13"]
  }
}
